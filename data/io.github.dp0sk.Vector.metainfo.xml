<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.dp0sk.Vector</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Vector</name>
  <summary>Proxy client for GNOME</summary>
  <description>
    <p>
      Vector is a proxy client for sing-box and xray-core. Built with Libadwaita.
    </p>
    <p>Features:</p>
    <ul>
      <li>Support for VLESS, Reality, VMess, Trojan, Shadowsocks, WireGuard, and AmneziaWG</li>
      <li>Automatic subscription updates with support for custom User-Agent and xhttp headers</li>
      <li>Rule-based routing presets</li>
      <li>Desktop proxy configuration and system-wide TUN mode</li>
      <li>Real-delay HTTP latency and speed benchmarking with dynamic sorting</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.dp0sk.Vector.desktop</launchable>
  <url type="homepage">https://github.com/dp0sk/Vector</url>
  <url type="bugtracker">https://github.com/dp0sk/Vector/issues</url>
  <url type="vcs-browser">https://github.com/dp0sk/Vector</url>
  <developer id="io.github.dp0sk">
    <name>dp0sk</name>
  </developer>
  <provides>
    <binary>vector-adw</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
